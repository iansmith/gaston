# Build artifacts (local builds only, not container outputs)
build/
/gaston
/gastonlibc
*.o
*.elf
*.a

# Container output binaries ARE tracked (they're the project's deliverables)
!third-party/*/output/**

# Vendored musl source (downloaded locally, not tracked)
/musl/


# Scratch markdown notes (not tracked). design/ is for committed docs.
/docs/
scratch/
.slopstop/
# Per-developer overrides. The tracked files hold the project's settings;
# these hold what is yours alone (a fork URL, a local endpoint, sandbox paths).
CLAUDE.local.md
.project-conf-local.toml
.claude/settings.local.json
*.bak
